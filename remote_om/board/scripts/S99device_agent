#!/bin/sh

APP="/opt/remote_om/bin/device_agent"
CONF="/etc/device_agent/device_agent.conf"
PIDFILE="/var/run/device_agent.pid"

start() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "device_agent already running"
		return 0
	fi

	if [ ! -x "$APP" ]; then
		echo "missing executable: $APP" >&2
		return 1
	fi

	echo "starting device_agent..."
	"$APP" -c "$CONF" &
	echo $! > "$PIDFILE"
}

stop() {
	if [ ! -f "$PIDFILE" ]; then
		echo "device_agent not running"
		return 0
	fi

	PID="$(cat "$PIDFILE")"
	if kill -0 "$PID" 2>/dev/null; then
		echo "stopping device_agent..."
		kill "$PID"
		sleep 1
	fi

	rm -f "$PIDFILE"
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "device_agent running pid=$(cat "$PIDFILE")"
	else
		echo "device_agent stopped"
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	status)
		status
		;;
	*)
		echo "usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac
